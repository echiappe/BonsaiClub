                  <Expression xsi:type="ipy:PythonTransform">
                    <ipy:Name>VRLoop</ipy:Name>
                    <ipy:Script>import clr
import math
import random

clr.AddReference("OpenCV.Net")
from OpenCV.Net import Point2f
from System import Tuple, Convert

# ==========================================
# DEMO MODE TOGGLE
# Set to True to use Open Loop (Simulated Protocol Target)
# Set to False to use Closed Loop (Live Fly Tracking Override)
# ==========================================
USE_OPEN_LOOP = True

# ==========================================
# CONSTANTS NOT PROVIDED IN PARAMS
# ==========================================
DT = 0.011765       # Fixed time interval between frames (seconds)

# ==========================================
# GLOBALS FOR PROTOCOL STATE
# ==========================================
StimX = None        
StimY = None        
StimOri = None      
state = None        
event = None        
current_angle = 0.0 
current_radius = 0.0
angular_dir = 1
steps_taken = 0.0
target_steps = 0.0
path_mode = 0       
is_occlusion_active = False
current_turn_modifier = 1
red_led_state = True # Initialize Red LED state

# Updated signature: Added a 7th float for the Red LED state
# Time (float), StimPosition (Point2f), StimOri (float), State (float), Event (float), Occluded (float), RedLED (float)
@returns(Tuple[float, Point2f, float, float, float, float, bool])
def process(value):
    global StimX, StimY, StimOri, state, event
    global current_angle, current_radius, angular_dir, steps_taken, target_steps, path_mode
    global is_occlusion_active, current_turn_modifier, red_led_state
    global USE_OPEN_LOOP

    # ---------------------------------------------------------
    # 1. Unpack Tracking Data (Item1)
    # ---------------------------------------------------------
    zip_data = value.Item1
    FlyCentroid = zip_data.FlyCentroid
    FlyOrientation = zip_data.FlyOrientation
    Time = Convert.ToDouble(zip_data.Time)

    # ---------------------------------------------------------
    # 2. Unpack Dynamic Parameters (Item2)
    # ---------------------------------------------------------
    params = value.Item2
    
    SPEED = Convert.ToDouble(params.Speed)
    R = Convert.ToDouble(params.EdgeRadius)
    MIN_EVENT_TIME = Convert.ToDouble(params.MinInBetweenEvent)
    MAX_EVENT_TIME = Convert.ToDouble(params.MaxInBetweenEvent)
    OCCLUSION_TIME = Convert.ToDouble(params.Occlusion)
    LETHARGY_TIME = Convert.ToDouble(params.Lethargy)
    DELAY_OCCLUSION_TIME = Convert.ToDouble(params.DelayOcclusion)
    DELAY_TURN_TIME = Convert.ToDouble(params.DelayTurn)
    TURN_MODE = Convert.ToInt32(params.TurnMode)    
    SIGN = Convert.ToInt32(params.Direction)        

    # Derived Protocol Constants
    DIST_PER_STEP = SPEED * DT              
    OCCLUSION_DIST = SPEED * OCCLUSION_TIME 
    OCCLUSION_RADIUS = OCCLUSION_DIST / 2.0 

    # ---------------------------------------------------------
    # PHASE 1: Initialization &amp; Lethargy Period
    # ---------------------------------------------------------
    if Time &lt; LETHARGY_TIME or StimX is None:
        StimX = R
        StimY = 0.0
        StimOri = 0.0
        state = 99
        event = 0
        
        current_angle = 0.0
        current_radius = R
        angular_dir = SIGN
        steps_taken = 0.0
        path_mode = 0
        is_occlusion_active = False
        current_turn_modifier = 1
        
        target_time = random.uniform(MIN_EVENT_TIME, MAX_EVENT_TIME)
        target_steps = target_time / DT
        
        occluded = 0.0

    # ---------------------------------------------------------
    # PHASE 2: Protocol Execution Loop
    # ---------------------------------------------------------
    else:
        PrevX, PrevY = StimX, StimY 
        distance_to_move = DIST_PER_STEP
        
        while distance_to_move &gt; 0.0001: 
            
            if path_mode == 0:
                dist_to_turn = (target_steps - steps_taken) * DIST_PER_STEP
                if distance_to_move &lt; dist_to_turn:
                    current_angle += angular_dir * (distance_to_move / R)
                    steps_taken += distance_to_move / DIST_PER_STEP
                    distance_to_move = 0.0
                else:
                    current_angle += angular_dir * (dist_to_turn / R)
                    distance_to_move -= dist_to_turn
                    time_active = Time - LETHARGY_TIME
                    
                    if time_active &lt; DELAY_TURN_TIME:
                        path_mode = 1 
                    else:
                        if TURN_MODE == 0:
                            rand_choice = random.random()
                            if rand_choice &lt; 0.333333:
                                path_mode = 1
                            elif rand_choice &lt; 0.666667:
                                path_mode = 2
                                current_turn_modifier = 1
                            else:
                                path_mode = 2
                                current_turn_modifier = -1
                        else:
                            if random.random() &lt; 0.5:
                                path_mode = 1
                            else:
                                path_mode = 2
                                current_turn_modifier = SIGN * TURN_MODE
                            
                    if time_active &lt; DELAY_OCCLUSION_TIME:
                        is_occlusion_active = False 
                    else:
                        is_occlusion_active = (random.random() &lt; 0.5)
                        
                    current_radius = R
            
            elif path_mode == 1:
                dist_to_edge = current_radius - (-R) 
                if distance_to_move &lt; dist_to_edge:
                    current_radius -= distance_to_move
                    distance_to_move = 0.0
                else:
                    distance_to_move -= dist_to_edge
                    current_angle += math.pi   
                    current_radius = R
                    path_mode = 0
                    steps_taken = 0.0
                    target_steps = random.uniform(MIN_EVENT_TIME, MAX_EVENT_TIME) / DT
                    is_occlusion_active = False 
                    
            elif path_mode == 2:
                dist_to_center = current_radius
                if distance_to_move &lt; dist_to_center:
                    current_radius -= distance_to_move
                    distance_to_move = 0.0
                else:
                    distance_to_move -= dist_to_center
                    current_radius = 0.0
                    current_angle += current_turn_modifier * (math.pi / 2.0)
                    path_mode = 3
                    
            elif path_mode == 3:
                dist_to_edge = R - current_radius
                if distance_to_move &lt; dist_to_edge:
                    current_radius += distance_to_move
                    distance_to_move = 0.0
                else:
                    distance_to_move -= dist_to_edge
                    current_radius = R
                    path_mode = 0
                    steps_taken = 0.0
                    target_steps = random.uniform(MIN_EVENT_TIME, MAX_EVENT_TIME) / DT
                    is_occlusion_active = False 

        # --- MOVEMENT EXECUTION ---
        StimX = current_radius * math.cos(current_angle)
        StimY = current_radius * math.sin(current_angle)
        
        if StimX != PrevX or StimY != PrevY:
            StimOri = math.atan2(StimY - PrevY, StimX - PrevX)

        # --- STATE &amp; EVENT EVALUATION ---
        if path_mode == 0:
            state = 0
            event = 0
        elif path_mode == 1:
            state = 1 if current_radius &gt;= 0 else 2
            event = 2 if is_occlusion_active else 1
        elif path_mode == 2 or path_mode == 3:
            state = 1 if path_mode == 2 else 2
            if current_turn_modifier == SIGN:
                event = 4 if is_occlusion_active else 3
            else:
                event = 6 if is_occlusion_active else 5

    # ---------------------------------------------------------
    # PHASE 3: Occlusion Calculation
    # ---------------------------------------------------------
    if is_occlusion_active and abs(current_radius) &lt;= OCCLUSION_RADIUS:
        occluded = 1.0 
    else:
        occluded = 0.0 

    # ---------------------------------------------------------
    # PHASE 4: Open Loop vs Closed Loop Selection
    # ---------------------------------------------------------
    final_X = StimX
    final_Y = StimY
    final_Ori = StimOri

    if not USE_OPEN_LOOP:
        if FlyCentroid is not None and FlyOrientation is not None:
            try:
                final_X = Convert.ToDouble(FlyCentroid.X)
                final_Y = Convert.ToDouble(FlyCentroid.Y)
                final_Ori = Convert.ToDouble(FlyOrientation)
            except Exception:
                pass

    # ---------------------------------------------------------
    # PHASE 5: Red LED Controller
    # ---------------------------------------------------------
    # Set to always True for now
    red_led_state = True 

    # Return structured tuple
    return Tuple.Create(
        float(Time), 
        Point2f(float(final_X), float(final_Y)), 
        float(final_Ori), 
        float(state), 
        float(event), 
        float(occluded),
        bool(red_led_state)
    )</ipy:Script>
                  </Expression>
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Name>Rename Var</scr:Name>
                    <scr:Expression>new(
    Item1 as Time,
    Item2 as StimPosition,
    Item3 as StimOrientation,
    Item4 as State,
    Item5 as Event,
    Item6 as Occluded,
    Item7 as Red
)</scr:Expression>
