              <ipy:Script>import clr
import math
clr.AddReference("OpenCV.Net")
from OpenCV.Net import IplImage, Point, Scalar, CV, ColorConversion

def is_valid(pt):
    # Keeping the hasattr checks for X and Y to be extra safe
    return (
        pt is not None and
        hasattr(pt, 'X') and
        hasattr(pt, 'Y') and
        not math.isnan(pt.X) and
        not math.isnan(pt.Y)
    )

@returns(IplImage) 
def process(value):
    # 1. Maintain your exact input structure
    image, points = value

    # 2. Convert grayscale (1 channel) to color (3 channels) if necessary
    if image.Channels == 1:
        color_image = IplImage(image.Size, image.Depth, 3)
        CV.CvtColor(image, color_image, ColorConversion.Gray2Bgr)
        image = color_image

    # 3. Safely extract named properties using getattr()
    # If the property doesn't exist on the 'points' object, it defaults to None
    p1 = getattr(points, 'FlyCentroid', None)
    p2 = getattr(points, 'FlyHead', None)
    p3 = getattr(points, 'Fly2Centroid', None)
    p4 = getattr(points, 'Fly2Head', None)

    # 4. Draw each separately
    if is_valid(p1):
        CV.Circle(image, Point(int(p1.X), int(p1.Y)), 1, Scalar(255, 0, 0), -1)

    if is_valid(p2):
        CV.Circle(image, Point(int(p2.X), int(p2.Y)), 1, Scalar(0, 255, 0), -1)

    if is_valid(p3):
        CV.Circle(image, Point(int(p3.X), int(p3.Y)), 1, Scalar(0, 0, 255), -1)

    if is_valid(p4):
        CV.Circle(image, Point(int(p4.X), int(p4.Y)), 1, Scalar(0, 255, 255), -1)

    return image</ipy:Script>
