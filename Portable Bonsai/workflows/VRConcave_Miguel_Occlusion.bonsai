                  <Expression xsi:type="ipy:PythonTransform">
                    <ipy:Name>PhotodiodeFlash</ipy:Name>
                    <ipy:Script>@returns(float)
def process(value):
    """
    value: tuple (Item1, Item2)
        - Item1: elapsed experimental time in seconds (float)
        - Item2: period in milliseconds (float)
    Output:
        1.0 → ON, 0.0 → OFF
        ON for first half of period, OFF for second half, repeating
    """
    elapsed_time = value.Item1
    period_s = value.Item2

    # Compute the modulo to find position in cycle
    t_mod = elapsed_time % period_s

    # ON for first half, OFF for second half
    state = 1.0 if t_mod &lt; (period_s / 2.0) else 0.0

    return state</ipy:Script>
