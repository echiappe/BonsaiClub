                    <ipy:Script>import clr
import math
clr.AddReference("OpenCV.Net")
from OpenCV.Net import Point2f

@returns(Point2f)
def process(value):
    fly_centroid = value.FlyCentroid
    fly2_centroid = value.Fly2Centroid

    # Check if the point is missing or contains NaN values
    if (fly_centroid is None or 
        math.isnan(fly_centroid.X) or 
        math.isnan(fly_centroid.Y)):
        
        # Output the fallback centroid
        return fly2_centroid
        
    # Otherwise, output the primary centroid
    return fly_centroid</ipy:Script>
